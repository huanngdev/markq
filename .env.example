DATABASE_URL=./data/markq.db

# Optional: enables the per-question AI tutor through OpenRouter (server-only).
OPENROUTER_API_KEY=

# Required to enable the protected /manage editor and admin API.
# Generate a long random value; send it as a Bearer token from the editor.
# MARKQ_ADMIN_TOKEN=replace-with-at-least-32-random-characters

# Public URL used for canonical links and social metadata in production.
# NEXT_PUBLIC_SITE_URL=https://quiz.example.com
